{
  "version": 1,
  "id": "clocks",
  "name": "World clocks",
  "grid": { "columns": 12, "rows": 12 },
  "widgets": [
    {
      "id": "local-clock",
      "widget": "../widgets/clock.lua",
      "rect": { "x": 0, "y": 2, "width": 6, "height": 6 },
      "options": { "timezone": "local" }
    },
    {
      "id": "utc-clock",
      "widget": "../widgets/clock.lua",
      "rect": { "x": 6, "y": 2, "width": 6, "height": 6 },
      "options": { "timezone": "UTC" }
    }
  ]
}
